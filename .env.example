# Supabase settings (the Vite configuration safely exposes only these two
# public values to the browser; never use the service-role key client-side)
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Server-only settings — never use the VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-server-secret
PUBLIC_SITE_URL=https://example.com
# PostgreSQL connection string from Supabase Dashboard → Connect.
# Required only for versioned migration deployment; never expose to the browser.
SUPABASE_DB_URL=postgresql://postgres.project-ref:password@host:5432/postgres
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
RATE_LIMIT_SECRET=generate-a-long-random-server-only-value
RESEND_API_KEY=your-resend-key
FROM_EMAIL=hello@example.com
FROM_NAME=Daksh Study Platform
RAZORPAY_KEY_ID=your-razorpay-key-for-this-environment
RAZOR_PAY_SECRET_KEY=your-razorpay-secret-for-this-environment
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
GROQ_KEY=your-ai-provider-key

# Initial platform administrator (used only by the one-time bootstrap script)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=use-a-strong-unique-password
SUPERADMIN_FULL_NAME=Platform Administrator
